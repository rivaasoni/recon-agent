# ---------------------------------------------------------------------------
# SECRETS  — the most important rules in this file.
# .env holds the Anthropic API key. It must never be committed.
# .env.example is the safe, value-free template and IS committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# DATA OUTPUTS — everything under data/ is generated by running the project,
# so it is reproducible and does not belong in git. The .gitkeep placeholder
# files are the exception: they keep the empty folders present in the repo.
# ---------------------------------------------------------------------------
data/**
!data/**/
!data/**/.gitkeep
*.duckdb
*.duckdb.wal
*.db

# Agent run artifacts (traces, eval results) — regenerated on every run
traces/
eval_results/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# dbt
# ---------------------------------------------------------------------------
dbt_recon/target/
dbt_recon/dbt_packages/
dbt_recon/logs/
# Anonymous per-machine ID dbt creates on first run. (Note: .gitignore only
# allows comments on their own line — a trailing "# ..." would become part of
# the pattern and silently match nothing.)
dbt_recon/.user.yml
logs/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
