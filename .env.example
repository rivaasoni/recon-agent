# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# .env is git-ignored. .env.example is committed, so it must never hold a real key.

# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Which Claude model the agent uses.
# claude-opus-5  = most capable (default)
# claude-sonnet-5 = cheaper, still strong — a good swap once evals are running
RECON_MODEL=claude-opus-5
